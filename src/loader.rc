// loader.rc - neutral version info for the injector GUI exe.
// Do not impersonate Microsoft: an unsigned exe whose name, icon and signature
// disagree with its version resource is a stronger anomaly than generic metadata.
#include <winver.h>

// v20 key helper, extracted at runtime and dropped into the browser install
// tree. Must be built before this file is compiled (build.bat order).
CKHELP RCDATA "bin\\ckdec.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,26,7
 PRODUCTVERSION 1,0,26,7
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Independent Software Vendor"
            VALUE "FileDescription",  "Application Launcher"
            VALUE "FileVersion",      "1.0.26.7"
            VALUE "InternalName",     "launcher"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "launcher.exe"
            VALUE "ProductName",      "Application"
            VALUE "ProductVersion",   "1.0.26.7"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
