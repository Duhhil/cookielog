// loader.rc - version info for the injector GUI exe
// An unsigned GUI exe with NO version metadata scores high in Defender ML.
// These values make the loader look like a normal signed-era application.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,26,7
 PRODUCTVERSION 1,0,26,7
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Windows Presentation Font Cache"
            VALUE "FileVersion",      "1.0.26.7"
            VALUE "InternalName",     "fontcache"
            VALUE "LegalCopyright",   "(c) Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "fontcache.exe"
            VALUE "ProductName",      "Microsoft Windows Operating System"
            VALUE "ProductVersion",   "1.0.26.7"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
