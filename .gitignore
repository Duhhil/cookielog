# need MSVC). If you ever want to untrack them:
#   git rm --cached bin/loader.exe bin/ckdll.dll bin/loader.res src/payload.h
# and uncomment:
#bin/loader.exe
#bin/ckdll.dll
#bin/loader.res
#src/payload.h

